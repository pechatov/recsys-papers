---
import { getCollection } from 'astro:content';
import SummaryLayout from '../layouts/SummaryLayout.astro';
import CikmVisitInfo from '../components/CikmVisitInfo.astro';
import { grades, days, ratingsById, scheduleById, schedule, rubric } from '../lib/cikm-2026';
import metadata from '../data/cikm-2026-papers.json';
const entries = await getCollection('cikm2026');
const byId = new Map(entries.map(e => [e.data.selectionId, e]));
const papers = [...metadata].sort((a, b) => {
  const left = scheduleById.get(a.selectionId)?.appearances[0];
  const right = scheduleById.get(b.selectionId)?.appearances[0];
  return (left?.start ?? '').localeCompare(right?.start ?? '') || a.selectionId.localeCompare(b.selectionId);
});
if (papers.length !== 99 || entries.length !== 99 || papers.some(p => !byId.has(p.selectionId) || !ratingsById.has(p.selectionId) || !scheduleById.has(p.selectionId))) {
  throw new Error('CIKM 2026 must contain the 99 approved reviews, ratings and schedules.');
}
const base = import.meta.env.BASE_URL;
const labels: Record<string, string> = {
  generative: 'Генеративные рекомендации', semantic_ids: 'Семантические ID',
  sequential: 'Sequential и session-based', industrial: 'Индустриальные системы'
};
const fullTextCount = entries.filter(e => e.data.basis === 'full_text').length;
const dayPapers = (date: string) => papers.filter(p => scheduleById.get(p.selectionId)!.appearances.some(a => a.date === date));
---
<SummaryLayout title="CIKM 2026: что читать и куда идти" catalogId="cikm-2026" backHref={`${base}summaries/papers.html`} backLabel="← К тематическому каталогу">
  <nav aria-label="Разделы каталога" class="site-tabs">
    <a href={`${base}summaries/papers.html`}>Тематический каталог</a>
    <a href={`${base}conferences.html`}>Архив конференций</a>
    <a href={`${base}cikm-2026.html`} aria-current="page">Разборы CIKM 2026</a>
  </nav>
  <p>99 статей по генеративным рекомендациям, семантическим ID, последовательным рекомендациям и промышленным системам. Все обзоры основаны на полных текстах; у каждой статьи — четыре вопроса авторам.</p>
  <p>Рим · 7–11 ноября 2026 · <a href={schedule.sourceUrl}>Официальная программа</a> · Сверено {schedule.checkedAt}.</p>
  <aside class="scope">
    <p><strong>Время местное для Рима: CET (UTC+1).</strong> Для докладов указано время всей сессии: точное начало отдельного выступления не опубликовано. В программе 44 работы из подборки указаны в устных сессиях, 55 — в постерных. Устным работам отдельный постер не приписывается, если его нет в программе.</p>
    <p>Основная площадка: Auditorium Parco della Musica Ennio Morricone. У доклада указан зал, у постера — стенд. Обзор и версия прочитанного источника доступны на странице статьи.</p>
  </aside>
  <details class="rubric"><summary>Как читать оценки и выбирать визиты</summary>
    <p>Это редакционный приоритет посещения внутри выбранных 99 статей, а не объективная оценка работы или решение рецензентов. Интерес — содержательность идеи; убедительность — качество протокола, сравнений и доказательств; важность — потенциальная польза для рекомендательных систем. Каждый критерий оценивается от 1 до 5.</p>
    <p><strong>Крутые:</strong> сумма не ниже {rubric.strongTotal}, убедительность не ниже {rubric.strongMinEvidence}. Оценки 4/4/4 означают хорошую нормальную работу; в верхней группе нужен выдающийся результат хотя бы по одному критерию. <strong>Не очень сильные:</strong> сумма не выше {rubric.weakerTotal} либо убедительность не выше {rubric.weakerMaxEvidence} при интересе не выше {rubric.weakerMaxInterest}. Остальные — <strong>нормальные</strong>. Интересная идея может остаться в средней группе из-за слабой проверки. Закрытые данные и отсутствие онлайн-теста сами по себе не понижают группу.</p>
    <p>Внутри дня статьи сгруппированы по оценке и упорядочены по началу сессии. Одновременные доклады в разных залах могут пересекаться; индивидуальные времена не вычисляются по порядку в программе.</p>
  </details>
  <div class="overview"><table>
    <caption>Подборка по дням — выберите день для планирования</caption>
    <thead><tr><th scope="col">День</th>{Object.entries(grades).map(([, label]) => <th scope="col">{label}</th>)}<th scope="col">Доклады / постеры</th></tr></thead>
    <tbody>{days.map(day => {
      const items = dayPapers(day.date);
      return <tr><th scope="row"><a href={`?day=${day.date}#filters`}>{day.label}</a></th>
        {Object.keys(grades).map(grade => <td>{items.filter(p => ratingsById.get(p.selectionId)!.group === grade).length}</td>)}
        <td>{items.filter(p => scheduleById.get(p.selectionId)!.appearances.some(a => a.kind === 'oral')).length} / {items.filter(p => scheduleById.get(p.selectionId)!.appearances.some(a => a.kind === 'poster')).length}</td>
      </tr>;
    })}</tbody>
  </table></div>
  <form id="filters" class="filters" role="search" onsubmit="return false">
    <label>Поиск по названию, авторам и описанию<input id="paper-search" type="search" placeholder="Например: токенизация, LinkedIn, Gryphon" /></label>
    <label>День<select id="day"><option value="all">Все дни</option>{days.map(day => <option value={day.date}>{day.label}</option>)}</select></label>
    <label>Группа<select id="grade"><option value="all">Все группы</option>{Object.entries(grades).map(([key,label]) => <option value={key}>{label}</option>)}</select></label>
    <label>Формат<select id="format"><option value="all">Все форматы</option><option value="oral">Есть доклад</option><option value="poster_only">Только постер</option></select></label>
    <label>Тема<select id="topic"><option value="all">Все темы</option>{Object.entries(labels).map(([key,label]) => <option value={key}>{label}</option>)}</select></label>
    <label hidden={fullTextCount === papers.length}>Основа обзора<select id="basis"><option value="full_text" selected>Полный текст</option><option value="all">Все источники</option>{fullTextCount < papers.length && <option value="abstract">Аннотация</option>}</select></label>
    <label class="check"><input id="priority" type="checkbox" /> Исходная первая очередь</label>
    <button type="reset">Сбросить</button>
  </form>
  <p id="result-count" role="status" aria-live="polite">Показано: {fullTextCount} из 99</p>
  <p id="empty-state" hidden>Статьи не найдены. Попробуйте изменить запрос или фильтры.</p>
  <div id="paper-list">
    {days.map(day => <section data-day-group={day.date}>
      <h2>{day.label}</h2>
      {Object.entries(grades).map(([grade, label]) => <section data-rating-group={grade}>
        <h3>{label} · <span data-group-count>{dayPapers(day.date).filter(p => ratingsById.get(p.selectionId)!.group === grade).length}</span></h3>
        {dayPapers(day.date).filter(p => ratingsById.get(p.selectionId)!.group === grade).map(paper => {
          const review = byId.get(paper.selectionId)!;
          const visit = scheduleById.get(paper.selectionId)!;
          return <article id={paper.selectionId} data-paper data-topics={paper.categories.join(' ')} data-basis={review.data.basis} data-priority={paper.priority} data-grade={grade} data-days={visit.appearances.map(a => a.date).join(' ')} data-presentation={visit.presentation} data-has-oral={visit.appearances.some(a => a.kind === 'oral') ? 'true' : 'false'} hidden={review.data.basis !== 'full_text'}>
            <p class="meta">{paper.selectionId} · {paper.track}</p>
            <h4><a href={`${base}cikm-2026/${paper.selectionId.toLowerCase()}.html`}>{paper.title}</a></h4>
            <div class="tags">{paper.categories.map(c => <span>{labels[c]}</span>)}</div>
            <p>{review.data.takeaway}</p>
            <CikmVisitInfo selectionId={paper.selectionId} />
            <details><summary>Авторы и сессия</summary><p>{paper.authors}</p><p><a href={paper.sessionUrl}>{paper.session}</a></p></details>
            <p class="links"><a href={`${base}cikm-2026/${paper.selectionId.toLowerCase()}.html`}>Читать обзор →</a><a href={`${base}cikm-2026/${paper.selectionId.toLowerCase()}.html#вопросы-авторам`}>Вопросы авторам</a><a href={paper.url ?? paper.sessionUrl}>Оригинал</a></p>
          </article>;
        })}
      </section>)}
    </section>)}
  </div>
</SummaryLayout>
<style>
  .site-tabs { display:flex; flex-wrap:wrap; gap:1rem; margin-bottom:2rem; }
  .site-tabs [aria-current] { font-weight:700; }
  .scope { padding:.4rem 1rem; background:var(--soft); border-left:3px solid var(--link); }
  .rubric { margin:1.5rem 0; }
  .rubric summary { cursor:pointer; font-weight:600; }
  .overview { overflow-x:auto; }
  table { border-collapse:collapse; width:100%; font-size:.9rem; }
  caption { text-align:left; font-weight:600; padding:.5rem 0; }
  th,td { padding:.6rem; text-align:left; border-bottom:1px solid var(--border); }
  .filters { display:flex; flex-wrap:wrap; gap:1rem; align-items:end; margin:2rem 0 1rem; scroll-margin-top:1rem; }
  label { display:flex; flex-direction:column; gap:.35rem; font-size:.9rem; }
  label:first-child { flex:1 1 100%; }
  input,select,button { font:inherit; color:var(--fg); background:var(--bg); border:1px solid var(--border); border-radius:6px; padding:.6rem; max-width:100%; }
  .check { flex-direction:row; align-items:center; padding:.6rem 0; }
  button { cursor:pointer; }
  input:focus-visible,select:focus-visible,button:focus-visible { outline:2px solid var(--focus); outline-offset:3px; }
  [data-day-group] > h2 { margin-top:2.5rem; }
  [data-rating-group] > h3 { padding:.7rem 0; border-bottom:2px solid var(--border); }
  article { padding:1.5rem 0; border-bottom:1px solid var(--border); scroll-margin-top:1rem; }
  article h4 { margin:.25rem 0 .65rem; font-size:1.25rem; }
  .meta { color:var(--muted); font-size:.85rem; }
  .tags { display:flex; gap:.4rem; flex-wrap:wrap; }
  .tags span { font-size:.8rem; padding:.15rem .5rem; background:var(--soft); border:1px solid var(--border); border-radius:5px; }
  .links { display:flex; gap:1rem; flex-wrap:wrap; }
  [hidden] { display:none !important; }
</style>
<script>
  const search = document.querySelector<HTMLInputElement>('#paper-search')!;
  const selects = Object.fromEntries(['topic', 'basis', 'day', 'grade', 'format'].map(id => [id, document.querySelector<HTMLSelectElement>(`#${id}`)!]));
  const priority = document.querySelector<HTMLInputElement>('#priority')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-paper]')];
  function filter() {
    const query = search.value.trim().toLocaleLowerCase('ru');
    let visible = 0;
    for (const card of cards) {
      const matches = (!query || card.textContent?.toLocaleLowerCase('ru').includes(query))
        && (selects.topic.value === 'all' || card.dataset.topics?.split(' ').includes(selects.topic.value))
        && (selects.basis.value === 'all' || card.dataset.basis === selects.basis.value)
        && (selects.day.value === 'all' || card.dataset.days?.split(' ').includes(selects.day.value))
        && (selects.grade.value === 'all' || card.dataset.grade === selects.grade.value)
        && (selects.format.value === 'all' || (selects.format.value === 'oral' ? card.dataset.hasOral === 'true' : card.dataset.presentation === selects.format.value))
        && (!priority.checked || card.dataset.priority === 'first');
      card.hidden = !matches;
      if (matches) visible++;
      card.querySelectorAll<HTMLElement>('[data-appearance-date]').forEach(row => { row.hidden = selects.day.value !== 'all' && row.dataset.appearanceDate !== selects.day.value; });
    }
    document.querySelectorAll<HTMLElement>('[data-rating-group]').forEach(group => {
      const count = [...group.querySelectorAll<HTMLElement>('[data-paper]')].filter(card => !card.hidden).length;
      group.hidden = count === 0;
      group.querySelector('[data-group-count]')!.textContent = String(count);
    });
    document.querySelectorAll<HTMLElement>('[data-day-group]').forEach(group => {
      group.hidden = ![...group.querySelectorAll<HTMLElement>('[data-paper]')].some(card => !card.hidden);
    });
    document.querySelector('#result-count')!.textContent = `Показано: ${visible} из ${cards.length}`;
    document.querySelector<HTMLElement>('#empty-state')!.hidden = visible > 0;
  }
  document.querySelector('.filters')!.addEventListener('input', filter);
  document.querySelector('.filters')!.addEventListener('reset', () => setTimeout(filter, 0));
  function revealLinkedPaper() {
    let id: string;
    try { id = decodeURIComponent(window.location.hash.slice(1)); }
    catch { return; }
    const linked = cards.find(card => card.id === id);
    if (!linked) return;
    search.value = '';
    Object.values(selects).forEach(select => { select.value = 'all'; });
    priority.checked = false;
    selects.basis.value = linked.dataset.basis ?? 'full_text';
    filter();
    linked.scrollIntoView();
  }
  const params = new URLSearchParams(window.location.search);
  for (const [key, select] of Object.entries(selects)) {
    const requested = params.get(key);
    if (requested && [...select.options].some(option => option.value === requested)) select.value = requested;
  }
  filter();
  revealLinkedPaper();
  window.addEventListener('hashchange', revealLinkedPaper);
</script>
